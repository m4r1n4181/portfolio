# Kopiraj u .env.local (lokalno) ili dodaj u Vercel > Settings > Environment Variables.
# Chat radi sa bilo kojim "OpenAI-compatible" API-jem. Izaberi JEDNU opciju ispod.

# --- Opcija A: Qwen na Alibaba Cloud Model Studio (za objavljen sajt) ---
# Ključ: Model Studio konzola > API Keys. Ključ radi samo u regionu u kom je napravljen.
# Base URL za tvoj region i workspace je u konzoli (Singapur, SAD, Peking...).
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus

# --- Opcija B: Qwen lokalno preko Ollame (besplatno, samo na tvom računaru) ---
# Prvo u terminalu: ollama pull qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
# LLM_STREAM=1

# Adresa sajta, za sitemap i preview linkova (npr. https://marina.dev).
NEXT_PUBLIC_SITE_URL=

# Samo za testiranje bez ikakvog modela: lažni model koji uvek "odgovori" isto.
# CHAT_MOCK=1
